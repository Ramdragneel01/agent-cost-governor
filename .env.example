# Upstream LLM provider (proxied)
ACG_UPSTREAM_BASE_URL=https://api.openai.com
ACG_UPSTREAM_API_KEY=sk-replace-me

# Server
ACG_HOST=0.0.0.0
ACG_PORT=8090
ACG_LOG_LEVEL=INFO

# Policy file
ACG_POLICY_PATH=examples/policy.yaml

# Tenant identification
ACG_TENANT_HEADER=x-acg-tenant
ACG_DEFAULT_TENANT=default

# Alerts (Slack-compatible incoming webhook URL or any JSON receiver)
ACG_ALERT_WEBHOOK_URL=

ACG_SERVICE_NAME=agent-cost-governor
